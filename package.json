{
  "name": "livemap",
  "version": "0.2.0",
  "description": "See what your AI coding agent is building, live: every file, function, route and table it touches, with rewind.",
  "homepage": "https://livemap.in",
  "keywords": [
    "ai",
    "coding-agent",
    "agents",
    "code-map",
    "architecture",
    "visualization",
    "developer-tools",
    "live",
    "timeline",
    "cli"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "livemap": "dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/ui/.vite"
  ],
  "scripts": {
    "prebuild": "node scripts/ui-deps.mjs",
    "build": "tsup && node scripts/copy-grammars.mjs && npm --prefix ui run build && npm --prefix ui run build:export && node scripts/notices.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "playwright test",
    "docs:check": "node scripts/check-docs.mjs",
    "demo": "node scripts/demo.mjs",
    "smoke": "node scripts/smoke-pack.mjs",
    "budget": "node scripts/check-budget.mjs",
    "plugin:sync": "node scripts/sync-plugin.mjs",
    "licenses:check": "node scripts/notices.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "chokidar": "^4.0.3",
    "diff": "^7.0.0",
    "ignore": "^6.0.2",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/diff": "^6.0.0",
    "@types/node": "^20",
    "@types/ws": "^8.5.13",
    "tree-sitter-wasms": "0.1.13",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
