{
  "name": "livemap",
  "version": "0.1.0",
  "type": "module",
  "bin": { "livemap": "dist/cli.js" },
  "engines": { "node": ">=18" },
  "files": ["dist"],
  "scripts": {
    "prebuild": "node -e \"process.exit(require('fs').existsSync('ui/node_modules') ? 0 : 1)\" || (node -e \"process.exit(require('fs').existsSync('ui/package-lock.json') ? 0 : 1)\" && npm --prefix ui ci || npm --prefix ui install)",
    "build": "tsup && npm --prefix ui run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "diff": "^7.0.0",
    "ignore": "^6.0.2",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/diff": "^6.0.0",
    "@types/node": "^20",
    "@types/ws": "^8.5.13",
    "tsup": "^8.3.5",
    "typescript": "~5.6.3",
    "vitest": "^2.1.9"
  }
}
